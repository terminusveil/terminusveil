# Do not copy this file over the tracked .env; set the secrets on Vercel only.
# Public origin; the same value on Vercel.
VITE_SITE_URL=https://terminusveil.app
# Server reads: an RPC endpoint of your own (Alchemy, QuickNode, dRPC). The public RPC when unset.
TERMINUS_RPC_URL=
# Where eth_getLogs goes: the public RPC when unset. Hosted free tiers cap log queries to a few blocks (Alchemy: ten), which would empty the last-move and windows reads.
TERMINUS_LOGS_RPC_URL=
# The Wire poster wallet's private key. A dedicated wallet: never the owner's, never holds $VEIL. Vercel env only.
WIRE_POSTER_KEY=
# Shared secret the external pinger sends as `x-wire-key` to /api/wire/post. Vercel env only.
WIRE_CRON_KEY=
# CRON_SECRET is set by Vercel for its own cron (Project → Settings → Environment Variables); the route accepts it as Authorization: Bearer. Not needed locally.
# CRON_SECRET=
